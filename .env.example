# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Het .env bestand staat in .gitignore en wordt dus nooit gecommit.
#
# Instellingen die per pand verschillen (welke Google Sheet, welke bunq-rekening,
# welke Drive-map) staan NIET hier, maar in properties.json (zie properties.json.example).

# --- Google (geldt voor alle panden - één service account voor alles) ---
# Pad naar het service-account JSON-sleutelbestand (zie README stap 2)
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Pad naar het bestand met de lijst van panden (zie properties.json.example)
PROPERTIES_FILE=properties.json

# --- bunq (geldt voor alle panden - één bunq-koppeling voor alles) ---
# Pad naar het opgeslagen bunq API-context bestand (aangemaakt door scripts/setup_bunq.py)
BUNQ_CONF_FILE=bunq_production.conf
# PRODUCTION of SANDBOX (SANDBOX alleen voor testen met een bunq testaccount)
BUNQ_ENVIRONMENT=PRODUCTION
# Je bunq API key (alleen nodig bij het eenmalig draaien van scripts/setup_bunq.py)
BUNQ_API_KEY=

# --- Overig ---
# Aantal cent afwijking dat nog als "klopt" telt (afronding)
BEDRAG_TOLERANTIE_CENT=1
# Niet meer gebruikt door de matchlogica (die hanteert nu een vaste regel:
# 1e t/m 17e van de maand telt voor die maand, 18e t/m einde van de maand
# voor de maand erna) - mag blijven staan of verwijderd worden.
VOORUITBETALING_DAGEN=14
# Map waar de "laatste controle"-cache in wordt opgeslagen. Lokaal is "."
# (de projectmap) prima; op de VPS moet dit naar de meegekoppelde data-map
# wijzen (zie deploy/app.env.example) - anders is die cache na elke
# herbuild/deploy weer leeg.
STATE_DIR=.

# --- Webapp ---
# Geheime sleutel voor Flask sessies - vul een willekeurige lange random string in
FLASK_SECRET_KEY=
# Pad naar het bestand met gebruikersnamen, wachtwoorden en pand-toegang (zie scripts/create_user.py)
USERS_FILE=users.json

# --- E-mail (betaalherinnering/ingebrekestelling-knoppen op de Betalingen-pagina) ---
# Optioneel: zonder deze instellingen werken de knoppen niet (nette foutmelding i.p.v. crash).
# SMTP-gegevens van het mailaccount dat als afzender gebruikt wordt (bv. info@steenhub.nl).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAAM=Steenhub
# Komma-gescheiden lijst van adressen die een BCC krijgen van elke verstuurde mail
EMAIL_BCC=

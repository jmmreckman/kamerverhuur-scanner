# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Het .env bestand staat in .gitignore en wordt dus nooit gecommit.

# --- Google Sheets ---
# ID uit de URL van je sheet: https://docs.google.com/spreadsheets/d/<DIT_STUK>/edit
GOOGLE_SHEET_ID=
# Pad naar het service-account JSON-sleutelbestand (zie README stap 2)
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Naam van het tabblad met de kamers/huurders van Mahoniestraat 15
GOOGLE_SHEET_WORKSHEET=Mahoniestraat
# Naam van het tabblad waar de betaalgeschiedenis wordt bijgehouden (wordt aangemaakt als het niet bestaat)
GOOGLE_SHEET_HISTORY_WORKSHEET=Historie
# ID van de gedeelde Drive-map met documenten (huurcontracten, puntentelling, etc.) -
# uit de URL: https://drive.google.com/drive/folders/<DIT_STUK>
# Let op: deel deze map ook met het service-account e-mailadres (zie README).
GOOGLE_DRIVE_FOLDER_ID=

# --- bunq ---
# Pad naar het opgeslagen bunq API-context bestand (aangemaakt door scripts/setup_bunq.py)
BUNQ_CONF_FILE=bunq_production.conf
# PRODUCTION of SANDBOX (SANDBOX alleen voor testen met een bunq testaccount)
BUNQ_ENVIRONMENT=PRODUCTION
# Je bunq API key (alleen nodig bij het eenmalig draaien van scripts/setup_bunq.py)
BUNQ_API_KEY=
# IBAN van de SPECIFIEKE bunq-rekening waar de Mahoniestraat-huur op binnenkomt.
# Belangrijk: hiermee worden je andere rekeningen (privé, andere panden) genegeerd.
BUNQ_REKENING_IBAN=

# --- Overig ---
# Aantal cent afwijking dat nog als "klopt" telt (afronding)
BEDRAG_TOLERANTIE_CENT=1
# Aantal dagen vóór de 1e van de maand dat ook nog meegenomen wordt (voor
# huurders die ruim vooruit betalen, bv. al vanaf de 20e voor de maand erna)
VOORUITBETALING_DAGEN=14

# --- Webapp ---
# Geheime sleutel voor Flask sessies - vul een willekeurige lange random string in
FLASK_SECRET_KEY=
# Pad naar het bestand met gebruikersnamen + gehashte wachtwoorden (zie scripts/create_user.py)
USERS_FILE=users.json

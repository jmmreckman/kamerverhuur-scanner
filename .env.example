# Kopieer dit bestand naar ".env" en vul de echte waarden in.
# Zie README.md voor uitleg per instelling.

# Gmail-adres dat je speciaal voor dit programma hebt aangemaakt.
# Dit adres ontvangt de dagelijkse Funda-zoekopdracht-alert (IMAP) en wordt gebruikt
# om het rapport te versturen (SMTP), TENZIJ je hieronder eigen SMTP_*-instellingen
# invult -- dan blijft dit adres alleen voor het uitlezen van de Funda-alert.
SCANNER_GMAIL_ADDRESS=rotterdam.kamerverhuur.scanner@gmail.com

# Gmail-appwachtwoord (Google-account > Beveiliging > App-wachtwoorden).
SCANNER_GMAIL_APP_PASSWORD=

# Adres(sen) waar het dagrapport naartoe gestuurd wordt (komma-gescheiden bij meerdere).
REPORT_TO_ADDRESS=jmmreckman@gmail.com

# Map in Gmail waarin de Funda-alertmails binnenkomen. "INBOX" is prima als je
# geen apart label/filter gebruikt.
FUNDA_MAIL_FOLDER=INBOX

# Hoeveel dagen een gevonden huis in het rapport blijft staan nadat het voor het
# laatst is gezien, voordat het automatisch uit de actieve lijst verdwijnt. De
# dagelijkse beschikbaarheid-check (zie beschikbaarheid.py) haalt verkochte
# woningen er meestal al veel eerder uit; dit is het vangnet voor de gevallen die
# die check zelf niet met zekerheid kon vaststellen.
LISTING_EXPIRY_DAYS=30

# WOZ-grens voor de opkoopbescherming in Rotterdam (in euro's, zonder punten/komma's).
# De WOZ-waarde zelf wordt gratis en automatisch opgehaald bij de officiële
# WOZ-waardeloket-API van het Kadaster -- geen API-key of account nodig.
OPKOOPBESCHERMING_WOZ_GRENS=470000

# Ondergrens capaciteit voor Den Haag-woningen: een woning telt alleen als "geschikt"
# als er minstens zoveel bewoners mogelijk zijn (max bewoners = gebruiksoppervlakte //
# 18, met de wettelijke cap van 8). 6 betekent m² >= 108. Rotterdam gebruikt zijn eigen
# kamer-/oppervlaktelogica en raakt dit niet. Zie de "Den Haag"-sectie in README.md.
DEN_HAAG_MIN_BEWONERS=6

# Optioneel: verstuur het dagrapport via een eigen mailbox/domein in plaats van via
# Gmail (bijv. hetzelfde postvak dat je eigen website al gebruikt om mail te sturen).
# Funda-alerts blijven ALTIJD via SCANNER_GMAIL_ADDRESS/APP_PASSWORD hierboven gelezen
# (IMAP) -- dit stuurt alleen het uitgaande rapport (SMTP) via een andere mailbox.
# Laat deze regels leeg/weg om gewoon via Gmail te blijven versturen.
#
# SMTP_HOST=smtp.strato.de
# SMTP_PORT=587
# SMTP_USERNAME=info@steenhub.nl
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=info@steenhub.nl
# SMTP_FROM_NAAM=Steenhub

# --- Kaart-website kansen.steenhub.nl (kansen_site/) ---
# Alleen nodig voor die website, niet voor de dagelijkse scan zelf.

# Wie mag inloggen: "gebruiker1:wachtwoord1,gebruiker2:wachtwoord2". Mag leeg zijn
# als je in plaats daarvan (of daarnaast) met je Steenhub-accounts inlogt via
# STEENHUB_USERS_FILE hieronder - er moet minstens één inlogbron zijn, anders
# weigert de website te starten.
KANSEN_APP_USERS=jurian:kies-een-eigen-wachtwoord,justin:kies-een-eigen-wachtwoord

# Optioneel: wie de pagina Toegangsbeheer mag bedienen (accounts "buiten werking"
# zetten, zodat die bij het inloggen enkel een kale serverfout zien). Komma-lijst
# van gebruikersnamen. Leeg = automatisch alle KANSEN_APP_USERS hierboven.
KANSEN_APP_BEHEERDERS=

# Optioneel: pad naar de users.json van de steenhub.nl-app, zodat je op de kaart
# kunt inloggen met dezelfde accounts (gebruikersnaam + wachtwoord) als op
# steenhub.nl. In productie wordt dit bestand read-only in de kansen-container
# gekoppeld (zie deploy/docker-compose.yml) en staat deze variabele daar al goed.
STEENHUB_USERS_FILE=

# Willekeurige, geheime tekenreeks voor de inlogsessie (bv. `python3 -c "import
# secrets; print(secrets.token_hex(32))"`). Verplicht.
KANSEN_APP_SECRET_KEY=

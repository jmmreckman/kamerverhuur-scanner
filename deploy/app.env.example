# Kopieer naar app.env (dat bestand staat in .gitignore, nooit committen).
# Zelfde instellingen als de lokale .env, maar met paden die naar de
# meegekoppelde /app/data-map wijzen (zie docker-compose.yml).

GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/google-service-account.json
PROPERTIES_FILE=/app/data/properties.json

BUNQ_CONF_FILE=/app/data/bunq_production.conf
BUNQ_ENVIRONMENT=PRODUCTION
# BUNQ_API_KEY alleen tijdelijk nodig voor de eenmalige 'setup_bunq.py' (zie README) -
# daarna mag je deze regel weer verwijderen.
BUNQ_API_KEY=

USERS_FILE=/app/data/users.json
FLASK_SECRET_KEY=

BEDRAG_TOLERANTIE_CENT=1
VOORUITBETALING_DAGEN=14
# Belangrijk: moet naar de meegekoppelde data-map wijzen, anders is de
# "laatste controle"-cache na elke herbuild/deploy weer leeg.
STATE_DIR=/app/data

# Optioneel: voor de betaalherinnering/ingebrekestelling-knoppen (zie README stap 2b)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAAM=Steenhub
EMAIL_BCC=

# Optioneel: automatisch getekende contracten naar je eigen Google Drive
# wegschrijven (zie README "Drive-koppeling voor contracten (rclone)").
# RCLONE_CONFIG moet naar de meegekoppelde data-map wijzen (survives een
# herbuild/deploy); RCLONE_REMOTE is de rclone-remotenaam gevolgd door het
# pad naar je hoofdmap, bv. "gdrive:vastgoed".
RCLONE_CONFIG=/app/data/rclone.conf
RCLONE_REMOTE=

# Optioneel: communicatie-/onderhoudsmodule (AI + mail-inname).
# AI (concepten, samenvattingen, mailbeoordeling). Zonder key doen de
# AI-functies niets (de rest van de app blijft werken).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Telefoonnummer dat in de klusjesman-mail komt ("bel me boven 150 euro").
BEHEERDER_TELEFOON=

# Eenmalige Gmail-backfill van historische huurder-communicatie (zie
# scripts/gmail_backfill.py). App-wachtwoord (2FA aan); na de import intrekken.
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
GMAIL_EIGEN_ADRES=

# Fase 2: dagelijkse inname van de eigen Steenhub-mailboxen (service
# 'mail-inname'). onderhoud@ -> ticket, communicatie@ -> loggen + AI-beoordeling
# -> concept in de wachtrij. Zonder user/password slaapt die mailbox.
STEENHUB_IMAP_HOST=imap.strato.com
ONDERHOUD_IMAP_USER=
ONDERHOUD_IMAP_PASSWORD=
COMMUNICATIE_IMAP_USER=
COMMUNICATIE_IMAP_PASSWORD=

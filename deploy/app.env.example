# Kopieer naar app.env (dat bestand staat in .gitignore, nooit committen).
# Zelfde instellingen als de lokale .env, maar met paden die naar de
# meegekoppelde /app/data-map wijzen (zie docker-compose.yml).

GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/google-service-account.json
PROPERTIES_FILE=/app/data/properties.json

BUNQ_CONF_FILE=/app/data/bunq_production.conf
BUNQ_ENVIRONMENT=PRODUCTION
# BUNQ_API_KEY alleen tijdelijk nodig voor de eenmalige 'setup_bunq.py' (zie README) -
# daarna mag je deze regel weer verwijderen.
BUNQ_API_KEY=

USERS_FILE=/app/data/users.json
FLASK_SECRET_KEY=

BEDRAG_TOLERANTIE_CENT=1
VOORUITBETALING_DAGEN=14

# Optioneel: voor de betaalherinnering/ingebrekestelling-knoppen (zie README stap 2b)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAAM=Steenhub
EMAIL_BCC=

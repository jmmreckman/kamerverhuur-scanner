# Kopieer naar fundazoeker.env (dat bestand staat in .gitignore, nooit
# committen) - zelfde patroon als app.env/weight-tracker.env. Zonder de
# eerste twee variabelen start de container niet (crasht direct met een
# duidelijke foutmelding in de logs).

# Los Gmail-account, alleen voor dit script (niet een privé-account).
# Ontvangt de dagelijkse Funda-zoekopdracht-alert (IMAP) en wordt gebruikt
# om het rapport te versturen (SMTP), tenzij hieronder eigen SMTP_*-
# instellingen zijn ingevuld.
SCANNER_GMAIL_ADDRESS=

# Gmail-appwachtwoord (Google-account > Beveiliging > App-wachtwoorden,
# vereist 2FA aan op dat account).
SCANNER_GMAIL_APP_PASSWORD=

# Adres(sen) waar het dagrapport naartoe gaat (komma-gescheiden).
REPORT_TO_ADDRESS=jmmreckman@gmail.com,winkellink@gmail.com

# Map in Gmail waarin de Funda-alertmails binnenkomen.
FUNDA_MAIL_FOLDER=INBOX

# Hoeveel dagen een gevonden huis blijft staan nadat het voor het laatst
# is gezien, voordat het automatisch uit de actieve lijst verdwijnt.
LISTING_EXPIRY_DAYS=30

# WOZ-grens voor de opkoopbescherming in Rotterdam (in euro's).
OPKOOPBESCHERMING_WOZ_GRENS=470000

# Optioneel: verstuur het dagrapport via info@steenhub.nl (Strato) in
# plaats van via Gmail. Funda-alerts blijven altijd via SCANNER_GMAIL_*
# hierboven gelezen (IMAP) - dit stuurt alleen het uitgaande rapport
# (SMTP) via een andere mailbox. Laat leeg/weg om via Gmail te versturen.
#SMTP_HOST=smtp.strato.de
#SMTP_PORT=587
#SMTP_USERNAME=info@steenhub.nl
#SMTP_PASSWORD=
#SMTP_FROM_EMAIL=info@steenhub.nl
#SMTP_FROM_NAAM=Steenhub
